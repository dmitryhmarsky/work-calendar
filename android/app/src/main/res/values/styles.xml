<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/barColor</item>
        <item name="colorPrimaryDark">@color/barColor</item>
        <item name="colorAccent">#007AFF</item>
    </style>

    <!-- Main theme: system bars show the app background and follow light/dark icon color. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/splashBg</item>
        <item name="android:windowLightStatusBar">@bool/lightBars</item>
        <item name="android:windowLightNavigationBar">@bool/lightBars</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splashBg</item>
        <item name="android:windowLightStatusBar">@bool/lightBars</item>
    </style>
</resources>
